# ============================================================================
# gosearx — .gitignore
# ============================================================================

# ---- Go ----
# Compiled binary (built via `make build` / Docker; never committed).
/gosearx
# Generic Go build/test artifacts.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.prof
# Go workspace file (machine-local).
go.work
go.work.sum
# Vendored deps (we use modules, not vendoring).
/vendor/

# ---- Frontend (Vite / React) ----
web/node_modules/
# Built assets are regenerated by `npm run build`. Keep the dir (for go:embed)
# but ignore its contents; web/dist/.gitkeep is tracked so the directory exists.
web/dist/*
!web/dist/.gitkeep
# Vite / TypeScript / tooling caches and logs.
web/.vite/
web/*.local
web/*.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Secrets / local config ----
# Never commit real credentials. Secrets are injected via ${ENV} expansion in
# settings.yml; keep local env files out of git.
.env
.env.*
!.env.example
*.local.yml
*.local.yaml
settings.local.yml

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
